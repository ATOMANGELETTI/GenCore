{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenCore Terminal",
  "version": "0.1.0",
  "identifier": "com.gencore.terminal",
  "build": {
    "beforeDevCommand": "pnpm --filter @gencore/terminal dev",
    "beforeBuildCommand": "pnpm --filter @gencore/terminal build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GenCore Terminal",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'"],
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": [
          "ipc:",
          "http://ipc.localhost",
          "'self'",
          "ws://localhost:5173",
          "ws://127.0.0.1:5173"
        ],
        "img-src": ["'self'", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'"],
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
