{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#7E57C2",
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#26A69A",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFA000{{ end }}",
            "{{ if gt .Working.Unmerged 0 }}#E53935{{ end }}"
          ],
          "template": "on \ue725 {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#43A047",
          "template": "via \ue718 {{ .Full }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#7E57C2",
          "foreground_templates": ["{{ if gt .Code 0 }}#E53935{{ end }}"],
          "template": "\u276f "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#7E57C2",
    "template": "\u276f "
  }
}
