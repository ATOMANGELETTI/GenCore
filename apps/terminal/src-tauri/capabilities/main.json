{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.11.1/crates/tauri-schema-generator/schemas/capability.schema.json",
  "identifier": "main",
  "description": "Least-privilege capabilities for the GenCore Terminal main window: core window chrome controls, OS window theme, app-info, read-only system telemetry, pinned-tab load/save, scoped gencore-fs list/create/watch for the file tree, scoped gencore-pty open/write/resize/close, and scoped open-url for the GenCore GitHub repo only.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-theme",
    "gencore-core:allow-get-app-info",
    "gencore-core:allow-get-system-telemetry",
    "gencore-core:allow-load-pinned-tabs",
    "gencore-core:allow-save-pinned-tabs",
    "gencore-fs:allow-list",
    "gencore-fs:allow-list-drives",
    "gencore-fs:allow-create-file",
    "gencore-fs:allow-create-dir",
    "gencore-fs:allow-watch",
    "gencore-fs:allow-unwatch",
    "gencore-pty:allow-open",
    "gencore-pty:allow-write",
    "gencore-pty:allow-resize",
    "gencore-pty:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ATOMANGELETTI/GenCore" }]
    }
  ]
}
