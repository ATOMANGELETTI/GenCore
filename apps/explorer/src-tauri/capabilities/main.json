{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v2.11.1/crates/tauri-schema-generator/schemas/capability.schema.json",
  "identifier": "main",
  "description": "Least-privilege capability for the Explorer main window: window chrome controls, OS window theme, app-info, the gencore-fs commands the file explorer UI calls (list/stat/create/rename/delete/copy/move/watch), opening files with their OS default app, and scoped open-url for the GenCore GitHub repo only. No shell or http access.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-theme",
    "gencore-core:allow-get-app-info",
    "gencore-core:allow-set-theme-icon",
    "gencore-fs:allow-list",
    "gencore-fs:allow-list-drives",
    "gencore-fs:allow-stat",
    "gencore-fs:allow-create-file",
    "gencore-fs:allow-create-dir",
    "gencore-fs:allow-rename",
    "gencore-fs:allow-delete",
    "gencore-fs:allow-copy",
    "gencore-fs:allow-move-paths",
    "gencore-fs:allow-watch",
    "gencore-fs:allow-unwatch",
    "opener:allow-open-path",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/ATOMANGELETTI/GenCore" }]
    }
  ]
}
