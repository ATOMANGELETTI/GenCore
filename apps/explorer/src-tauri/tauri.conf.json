{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenCore Explorer",
  "version": "0.1.0",
  "identifier": "com.gencore.explorer",
  "build": {
    "beforeDevCommand": "pnpm --filter @gencore/explorer dev",
    "beforeBuildCommand": "pnpm --filter @gencore/explorer build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GenCore Explorer",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'"],
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
